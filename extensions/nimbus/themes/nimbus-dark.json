		"statusBarItem.remoteBackground": "#CC785C",
		"statusBarItem.remoteForeground": "#1F1E1D",
		"statusBarItem.prominentBackground": "#D97757",
		"statusBarItem.prominentForeground": "#1F1E1D",
		"statusBarItem.hoverBackground": "#FFFFFF14",

		"panel.background": "#1F1E1D",
		"panel.border": "#2E2C29",
		"panelTitle.activeForeground": "#F0EEE6",
		"panelTitle.activeBorder": "#D97757",
		"panelTitle.inactiveForeground": "#8F8B7E",

		"button.background": "#D97757",
		"button.foreground": "#1F1E1D",
		"button.hoverBackground": "#E08A6B",
		"button.secondaryBackground": "#3A3733",
		"button.secondaryForeground": "#D6D3C7",
		"button.secondaryHoverBackground": "#474340",

		"input.background": "#1A1918",
		"input.foreground": "#D6D3C7",
		"input.border": "#3A3733",
		"input.placeholderForeground": "#7A766B",
		"inputOption.activeBorder": "#D97757",
		"inputValidation.errorBackground": "#3A2624",
		"inputValidation.errorBorder": "#E06C6C",
		"dropdown.background": "#262624",
		"dropdown.border": "#3A3733",
		"dropdown.foreground": "#D6D3C7",
		"checkbox.background": "#1A1918",
		"checkbox.border": "#3A3733",

		"badge.background": "#D97757",
		"badge.foreground": "#1F1E1D",
