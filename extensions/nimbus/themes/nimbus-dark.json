		"sideBarSectionHeader.background": "#262624",
		"sideBarSectionHeader.foreground": "#D6D3C7",
		"sideBarSectionHeader.border": "#2E2C29",

		"list.activeSelectionBackground": "#3A3733",
		"list.activeSelectionForeground": "#F0EEE6",
		"list.inactiveSelectionBackground": "#302E2B",
		"list.hoverBackground": "#302E2B",
		"list.highlightForeground": "#D97757",
