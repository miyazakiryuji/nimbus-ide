		"editorRuler.foreground": "#2E2C29",
		"editorError.foreground": "#E06C6C",
		"editorWarning.foreground": "#D4A27F",
		"editorInfo.foreground": "#8FA9BF",
		"editorGutter.addedBackground": "#8FA37A",
