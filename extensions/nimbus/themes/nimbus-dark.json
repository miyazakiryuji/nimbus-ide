		"scrollbarSlider.background": "#FFFFFF14",
		"scrollbarSlider.hoverBackground": "#FFFFFF1F",
		"scrollbarSlider.activeBackground": "#FFFFFF2E",

		"quickInput.background": "#262624",
		"quickInputList.focusBackground": "#3A3733",
		"pickerGroup.foreground": "#D4A27F",
		"pickerGroup.border": "#3A3733",

		"notificationCenterHeader.background": "#262624",
		"notifications.background": "#262624",
		"notifications.border": "#3A3733",
		"notificationLink.foreground": "#E08A6B",

		"menu.background": "#262624",
		"menu.foreground": "#D6D3C7",
		"menu.selectionBackground": "#3A3733",
		"menu.border": "#3A3733",
		"menubar.selectionBackground": "#302E2B",

		"terminal.background": "#1F1E1D",
		"terminal.foreground": "#D6D3C7",
		"terminalCursor.foreground": "#D97757",
		"terminal.ansiBlack": "#1A1918",
		"terminal.ansiRed": "#E06C6C",
		"terminal.ansiGreen": "#8FA37A",
		"terminal.ansiYellow": "#D4A27F",
		"terminal.ansiBlue": "#8FA9BF",
		"terminal.ansiMagenta": "#C08F9E",
		"terminal.ansiCyan": "#8FB3AE",
		"terminal.ansiWhite": "#D6D3C7",
		"terminal.ansiBrightBlack": "#57544C",
		"terminal.ansiBrightRed": "#EE8585",
		"terminal.ansiBrightGreen": "#A5B991",
		"terminal.ansiBrightYellow": "#EBC894",
		"terminal.ansiBrightBlue": "#A6BED1",
		"terminal.ansiBrightMagenta": "#D3A6B4",
		"terminal.ansiBrightCyan": "#A6C7C2",
		"terminal.ansiBrightWhite": "#F0EEE6",

		"gitDecoration.modifiedResourceForeground": "#D4A27F",
		"gitDecoration.addedResourceForeground": "#8FA37A",
		"gitDecoration.deletedResourceForeground": "#E06C6C",
		"gitDecoration.untrackedResourceForeground": "#8FB3AE",
		"gitDecoration.ignoredResourceForeground": "#57544C",

		"peekView.border": "#D97757",
		"peekViewTitle.background": "#262624",
		"peekViewResult.background": "#1A1918",
		"peekViewEditor.background": "#1F1E1D",

		"welcomePage.tileBackground": "#262624",
		"welcomePage.tileBorder": "#3A3733",
		"welcomePage.progress.foreground": "#D97757",

		"charts.red": "#E06C6C",
		"charts.orange": "#D97757",
		"charts.yellow": "#D4A27F",
		"charts.green": "#8FA37A",
		"charts.blue": "#8FA9BF",
		"charts.purple": "#C08F9E",
		"charts.foreground": "#D6D3C7",
		"charts.lines": "#3A3733"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#7A766B", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "punctuation.definition.string", "string.quoted"],
			"settings": { "foreground": "#A5B991" }
		},
		{
			"scope": ["constant.character.escape", "string.regexp"],
			"settings": { "foreground": "#D4A27F" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.other", "keyword.other.unit"],
			"settings": { "foreground": "#D4A27F" }
		},
		{
			"scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#D97757" }
		},
		{
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#C2BFB3" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
			"settings": { "foreground": "#EBC894" }
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": { "foreground": "#8FA9BF" }
		},
		{
			"scope": ["variable", "meta.definition.variable.name", "support.variable"],
			"settings": { "foreground": "#D6D3C7" }
		},
		{
			"scope": ["variable.parameter", "variable.other.readwrite"],
			"settings": { "foreground": "#C2BFB3" }
		},
		{
			"scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
			"settings": { "foreground": "#CBB99E" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#D97757" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#EBC894" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#D97757", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code.block"],
			"settings": { "foreground": "#A5B991" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#8FA37A" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#E06C6C" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#E06C6C" }
		}
	],
	"semanticTokenColors": {
		"parameter": "#C2BFB3",
		"property": "#CBB99E",
		"class": "#8FA9BF",
		"interface": "#8FA9BF",
		"type": "#8FA9BF",
		"function": "#EBC894",
		"method": "#EBC894",
		"variable.readonly": "#D4A27F"
	}
}
