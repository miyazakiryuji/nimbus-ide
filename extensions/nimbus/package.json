{
  "name": "nimbus",
  "displayName": "Nimbus",
  "description": "Nimbus — a cockpit for piloting Claude Code agents.",
  "version": "0.1.0",
  "publisher": "idris",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "testObserver",
    "terminalDimensions"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "信頼していないフォルダでは Claude を実行しません（画面は開けるので、理由と信頼のしかたが分かります）。"
    }
  },
