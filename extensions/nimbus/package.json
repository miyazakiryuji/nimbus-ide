    "menus": {
      "editor/context": [
        {
          "command": "nimbus.askAboutSelection",
          "when": "editorTextFocus",
          "group": "nimbus@1"
        },
        {
          "command": "nimbus.generateWidgetTest",
          "when": "resourceExtname == .dart",
          "group": "nimbus@1"
        },
        {
          "command": "nimbus.saveSnippet",
          "when": "editorHasSelection",
          "group": "nimbus@2"
        },
        {
          "command": "nimbus.previewSkill",
          "when": "resourceExtname == .md && resourcePath =~ /\\\\.claude/",
          "group": "nimbus@1"
        }
      ],
      "commandPalette": [
        {
          "command": "nimbus.interrupt",
          "when": "nimbus.hasRunningSession"
        },
        {
          "command": "nimbus.useSkill",
          "when": "false"
        },
        {
          "command": "nimbus.promoteInstruction",
          "when": "false"
        },
        {
          "command": "nimbus.openReviewDiff",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "nimbus.clearReviewMarks",
          "when": "view == nimbus.review",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshReview",
          "when": "view == nimbus.review",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshMcp",
          "when": "view == nimbus.mcp",
          "group": "navigation"
        },
        {
          "command": "nimbus.approvals.denyAll",
          "when": "view == nimbus.approvals",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshUsage",
          "when": "view == nimbus.usage",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshSkills",
          "when": "view == nimbus.skills",
          "group": "navigation"
        },
        {
          "command": "nimbus.addClaudeMdSection",
          "when": "view == nimbus.claudeMd",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshClaudeMd",
          "when": "view == nimbus.claudeMd",
          "group": "navigation"
        },
        {
          "command": "nimbus.findSkill",
          "when": "view == nimbus.skills",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nimbus.useSkill",
          "when": "view == nimbus.skills && viewItem =~ /nimbusSkill/",
          "group": "inline"
        },
        {
          "command": "nimbus.approvals.allow",
          "when": "view == nimbus.approvals && viewItem =~ /nimbusApproval/ && nimbus.approvalQueueMode",
          "group": "inline@1"
        },
        {
          "command": "nimbus.approvals.deny",
          "when": "view == nimbus.approvals && viewItem =~ /nimbusApproval/ && nimbus.approvalQueueMode",
          "group": "inline@2"
        },
        {
          "command": "nimbus.approvals.alwaysAllow",
          "when": "view == nimbus.approvals && viewItem =~ /nimbusApprovalRule/ && nimbus.approvalQueueMode",
          "group": "nimbus@1"
        },
        {
          "command": "nimbus.reconnectMcp",
          "when": "view == nimbus.mcp && viewItem == nimbusMcpServer",
          "group": "inline"
        },
        {
          "command": "nimbus.toggleMcp",
          "when": "view == nimbus.mcp && viewItem =~ /nimbusMcpServer/",
          "group": "nimbus@1"
        },
        {
          "command": "nimbus.promoteInstruction",
          "when": "view == nimbus.claudeMd && viewItem == nimbusRepeatedInstruction",
          "group": "inline"
        },
        {
          "command": "nimbus.markReviewed",
          "when": "view == nimbus.review && viewItem == nimbusUnreviewed",
          "group": "inline"
        },
        {
          "command": "nimbus.markUnreviewed",
          "when": "view == nimbus.review && viewItem == nimbusReviewed",
          "group": "inline"
        }
      ]
    },
