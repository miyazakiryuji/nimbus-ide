{
  "name": "nimbus",
  "displayName": "Nimbus",
  "description": "Nimbus — a cockpit for piloting Claude Code agents.",
  "version": "0.1.0",
  "publisher": "idris",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "testObserver"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Nimbus はワークスペース内で Claude Code を実行するため、信頼されたフォルダでのみ動作します。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nimbus",
          "title": "Nimbus",
          "icon": "resources/nimbus.svg"
        }
      ]
    },
    "views": {
      "nimbus": [
        {
          "id": "nimbus.cockpit",
          "name": "コックピット",
          "type": "webview"
        },
        {
          "id": "nimbus.board",
          "name": "タスク",
          "type": "webview"
        },
        {
          "id": "nimbus.approvals",
          "name": "承認待ち",
          "visibility": "collapsed"
        },
        {
          "id": "nimbus.skills",
          "name": "スキル"
        },
        {
          "id": "nimbus.claudeMd",
          "name": "CLAUDE.md"
        },
        {
          "id": "nimbus.context",
          "name": "文脈",
          "visibility": "collapsed"
        },
        {
          "id": "nimbus.activity",
          "name": "セッションの中身",
          "visibility": "collapsed"
        },
        {
          "id": "nimbus.usage",
          "name": "使用量",
          "visibility": "collapsed"
        },
        {
          "id": "nimbus.mcp",
          "name": "MCP サーバー",
          "visibility": "collapsed"
        },
        {
          "id": "nimbus.help",
          "name": "ヘルプ（ゆあ）",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "nimbus.newSession",
        "title": "新しいセッションを開始",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.interrupt",
        "title": "実行中のセッションを中断",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.stopAll",
        "title": "すべてのセッションを止める（緊急停止）",
        "category": "Nimbus",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nimbus.showLog",
        "title": "ログを表示",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.sendLastTerminalFailure",
        "title": "直近に失敗したコマンドをセッションに投入",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.sendLastTestFailure",
        "title": "直近に失敗したテストをセッションに投入",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.verifyEdits",
        "title": "型エラーを差し戻す",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.newTask",
        "title": "新しいタスク（worktree を切って並列実行）",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.findSkill",
        "title": "スキルを探す",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.askYua",
        "title": "使い方を聞く（ゆあ）",
        "category": "Nimbus"
      },
      {
        "command": "nimbus.refreshSkills",
        "title": "スキル一覧を更新",
        "category": "Nimbus",
        "icon": "$(refresh)"
      },
      {
        "command": "nimbus.refreshClaudeMd",
        "title": "CLAUDE.md の一覧を更新",
        "category": "Nimbus",
        "icon": "$(refresh)"
      },
      {
        "command": "nimbus.addClaudeMdSection",
        "title": "CLAUDE.md に節を足す",
        "category": "Nimbus",
        "icon": "$(add)"
      },
      {
        "command": "nimbus.promoteInstruction",
        "title": "CLAUDE.md に足す",
        "category": "Nimbus",
        "icon": "$(arrow-right)"
      },
      {
        "command": "nimbus.useSkill",
        "title": "コックピットで使う",
        "category": "Nimbus",
        "icon": "$(play)"
      },
      {
        "command": "nimbus.refreshUsage",
        "title": "使用量を取得し直す",
        "category": "Nimbus",
        "icon": "$(refresh)"
      },
      {
        "command": "nimbus.compact",
        "title": "文脈を圧縮する（コンパクション）",
        "category": "Nimbus",
        "icon": "$(fold)"
      },
      {
        "command": "nimbus.approvals.allow",
        "title": "許可",
        "category": "Nimbus",
        "icon": "$(check)"
      },
      {
        "command": "nimbus.approvals.deny",
        "title": "拒否",
        "category": "Nimbus",
        "icon": "$(close)"
      },
      {
        "command": "nimbus.approvals.alwaysAllow",
        "title": "今後この種類は常に許可",
        "category": "Nimbus",
        "icon": "$(pass)"
      },
      {
        "command": "nimbus.approvals.denyAll",
        "title": "承認待ちをすべて拒否",
        "category": "Nimbus",
        "icon": "$(clear-all)"
      },
      {
        "command": "nimbus.searchTranscripts",
        "title": "過去セッションを検索",
        "category": "Nimbus",
        "icon": "$(search)"
      },
      {
        "command": "nimbus.rewind",
        "title": "チェックポイントまで戻す",
        "category": "Nimbus",
        "icon": "$(discard)"
      },
      {
        "command": "nimbus.refreshMcp",
        "title": "MCP サーバーを取得し直す",
        "category": "Nimbus",
        "icon": "$(refresh)"
      },
      {
        "command": "nimbus.reconnectMcp",
        "title": "MCP サーバーを繋ぎ直す",
        "category": "Nimbus",
        "icon": "$(debug-restart)"
      },
      {
        "command": "nimbus.toggleMcp",
        "title": "MCP サーバーの有効／無効を切り替える",
        "category": "Nimbus",
        "icon": "$(circle-slash)"
      },
      {
        "command": "nimbus.completionReport",
        "title": "完了報告を作る（証跡つき）",
        "category": "Nimbus",
        "icon": "$(beaker)"
      },
      {
        "command": "nimbus.editProtectedPaths",
        "title": "読ませたくないファイルを指定する",
        "category": "Nimbus",
        "icon": "$(shield)"
      },
      {
        "command": "nimbus.openDigest",
        "title": "ふりかえりを開く",
        "category": "Nimbus",
        "icon": "$(graph)"
      },
      {
        "command": "nimbus.explainLockDiff",
        "title": "ロックファイルの変更を読む",
        "category": "Nimbus",
        "icon": "$(package)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nimbus.interrupt",
          "when": "nimbus.hasRunningSession"
        },
        {
          "command": "nimbus.useSkill",
          "when": "false"
        },
        {
          "command": "nimbus.promoteInstruction",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "nimbus.refreshMcp",
          "when": "view == nimbus.mcp",
          "group": "navigation"
        },
        {
          "command": "nimbus.approvals.denyAll",
          "when": "view == nimbus.approvals",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshUsage",
          "when": "view == nimbus.usage",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshSkills",
          "when": "view == nimbus.skills",
          "group": "navigation"
        },
        {
          "command": "nimbus.addClaudeMdSection",
          "when": "view == nimbus.claudeMd",
          "group": "navigation"
        },
        {
          "command": "nimbus.refreshClaudeMd",
          "when": "view == nimbus.claudeMd",
          "group": "navigation"
        },
        {
          "command": "nimbus.findSkill",
          "when": "view == nimbus.skills",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nimbus.useSkill",
          "when": "view == nimbus.skills && viewItem =~ /nimbusSkill/",
          "group": "inline"
        },
        {
          "command": "nimbus.approvals.allow",
          "when": "view == nimbus.approvals && viewItem =~ /nimbusApproval/ && nimbus.approvalQueueMode",
          "group": "inline@1"
        },
        {
          "command": "nimbus.approvals.deny",
          "when": "view == nimbus.approvals && viewItem =~ /nimbusApproval/ && nimbus.approvalQueueMode",
          "group": "inline@2"
        },
        {
          "command": "nimbus.approvals.alwaysAllow",
          "when": "view == nimbus.approvals && viewItem =~ /nimbusApprovalRule/ && nimbus.approvalQueueMode",
          "group": "nimbus@1"
        },
        {
          "command": "nimbus.reconnectMcp",
          "when": "view == nimbus.mcp && viewItem == nimbusMcpServer",
          "group": "inline"
        },
        {
          "command": "nimbus.toggleMcp",
          "when": "view == nimbus.mcp && viewItem =~ /nimbusMcpServer/",
          "group": "nimbus@1"
        },
        {
          "command": "nimbus.promoteInstruction",
          "when": "view == nimbus.claudeMd && viewItem == nimbusRepeatedInstruction",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Nimbus",
      "properties": {
        "nimbus.permissions.autoApproveReadOnly": {
          "type": "boolean",
          "default": false,
          "description": "読み取り専用のツール（Read / Glob / Grep）を確認なしで許可します。書き込みや実行は常に確認します。"
        },
        "nimbus.claudeCodeExecutable": {
          "type": "string",
          "default": "",
          "description": "使用する Claude Code 実行ファイルのパス。空の場合は Nimbus に同梱されたものを使います。"
        },
        "nimbus.permissions.showDiffBeforeApproval": {
          "type": "boolean",
          "default": true,
          "description": "ファイルを書き換えるツールの承認を求める前に、変更内容を差分エディタで表示します。"
        },
        "nimbus.permissions.offerPartialAccept": {
          "type": "boolean",
          "default": true,
          "description": "書き換えの提案に変更が 2 か所以上あるとき、承認の選択肢に「一部だけ採用」を出します。外した変更は元のまま残ります。"
        },
        "nimbus.permissions.queueApprovals": {
          "type": "boolean",
          "default": false,
          "description": "承認をモーダルで聞かず、「承認待ち」ビューに積んで順に処理します。複数セッションを並列で走らせるときに、どのセッションが何で止まっているかを 1 か所で見られます。"
        },
        "nimbus.permissions.alwaysAllow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "確認せずに許可するツールの一覧。承認時の「今後この種類は常に許可」でここに追加されます。書きかたは Read（そのツール全部）／ Write(*.md)（拡張子）／ Bash(npm test)（コマンドの前方一致）。取り返しがつかない操作（rm -rf など）はルールに関わらず毎回確認します。"
        },
        "nimbus.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "ターンの完了と承認待ちの発生を OS の通知で知らせます。"
        },
        "nimbus.notifications.onlyWhenUnfocused": {
          "type": "boolean",
          "default": true,
          "description": "Nimbus のウィンドウが前面に無いときだけ通知します。見ている画面に重ねて出さないための既定です。"
        },
        "nimbus.usage.costLimitUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "1 セッションあたりの費用の上限（USD）。超える前に警告し、超えたら停止を促します。0 は上限なし。"
        },
        "nimbus.usage.warnAtPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "費用の上限に対して何 % で最初の警告を出すか。"
        },
        "nimbus.safety.blockProtectedReads": {
          "type": "boolean",
          "default": true,
          "description": "秘匿ファイル（.env・秘密鍵など）の読み取りを、承認を求めずに拒否します。一度読まれた内容は取り消せないため、既定で有効です。"
        },
        "nimbus.safety.protectedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "読み取りを禁止するファイルのパターン（glob）。空のときは既定の一覧（.env / *.pem / ~/.ssh など）を使います。先頭に ! を付けると除外規則になります。"
        },
        "nimbus.safety.scanBeforeSend": {
          "type": "boolean",
          "default": true,
          "description": "送信するテキストに資格情報らしき文字列が含まれていないかを、送る前に検査します。"
        },
        "nimbus.tasks.maxConcurrent": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "同時に実行するタスク（Claude セッション）の上限。上限に達したタスクは待機し、空きが出ると自動で開始します。"
        },
        "nimbus.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "定義ジャンプ・参照検索・型情報・呼び出し階層・診断を、Claude が使えるツールとして渡します（読み取りのみ・承認は求めません）。"
        },
        "nimbus.lsp.verifyEdits": {
          "type": "string",
          "enum": [
            "off",
            "ask",
            "auto"
          ],
          "enumDescriptions": [
            "確かめません。",
            "型エラーが増えたら通知で知らせ、差し戻すかを選べます。",
            "型エラーが増えたら自動でセッションへ差し戻します（上限あり）。"
          ],
          "default": "ask",
          "description": "Claude がファイルを書き換えたあと、そのターンで増えた型エラーだけを確かめます。"
        },
        "nimbus.lsp.maxAutoFixes": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "型エラーを自動で差し戻す回数の上限（1 セッションあたり）。直らないまま回り続けるのを止めます。"
        },
        "nimbus.terminal.captureFailures": {
          "type": "boolean",
          "default": true,
          "description": "ターミナルでコマンドが失敗したら、その出力をセッションに投入できる通知を出します。"
        },
        "nimbus.terminal.maxOutputLines": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 2000,
          "description": "セッションに投入するターミナル出力の行数の上限（末尾から数えます）。"
        },
        "nimbus.tests.captureFailures": {
          "type": "boolean",
          "default": true,
          "description": "テストが失敗したら、落ちたテストの名前・場所・メッセージをセッションに投入できる通知を出します。"
        },
        "nimbus.tests.maxFailures": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "セッションに投入する失敗テストの件数の上限。"
        },
        "nimbus.dialogue.confirmVaguePrompt": {
          "type": "boolean",
          "default": true,
          "description": "曖昧な指示を送ろうとしたとき、走らせる前に足りていない情報を確認します。対象のファイル名などが書かれていれば確認しません。"
        },
        "nimbus.hotReload.enabled": {
          "type": "boolean",
          "default": false,
          "description": "ターンが終わって対象ファイルが変わっていたら、リロードしてスクリーンショットを撮り、セッションへ自動で投入します（既定はオフ）。"
        },
        "nimbus.hotReload.reloadCommand": {
          "type": "string",
          "default": "",
          "description": "リロードを起こすシェルコマンド。空ならスクリーンショットだけを撮ります。"
        },
        "nimbus.hotReload.screenshotCommand": {
          "type": "string",
          "default": "",
          "description": "スクリーンショットを撮るシェルコマンド。{file} が出力先のパスに置き換わります（例: xcrun simctl io booted screenshot {file}）。"
        },
        "nimbus.hotReload.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".dart",
            ".swift",
            ".kt",
            ".tsx",
            ".jsx",
            ".vue",
            ".css"
          ],
          "description": "この拡張子のファイルが変わったときだけリロードします。空なら変更があれば常に。"
        },
        "nimbus.hotReload.maxRounds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "1 つの指示につき、自動で回してよい周回数の上限。"
        }
      }
    },
    "themes": [
      {
        "id": "Nimbus Dark",
        "label": "Nimbus Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/nimbus-dark.json"
      },
      {
        "id": "Nimbus Light",
        "label": "Nimbus Light",
        "uiTheme": "vs",
        "path": "./themes/nimbus-light.json"
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:nimbus",
    "watch": "gulp watch-extension:nimbus",
    "test": "node --test out/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miyazakiryuji/nimbus-ide.git"
  }
}
